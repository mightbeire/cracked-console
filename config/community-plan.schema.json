{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cracked-console/community-plan.schema.json",
  "title": "Cracked Console Community Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plan", "skills", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title", "startDate", "weeks"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "format": "date" },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "weeks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/week" } }
      }
    },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "reading": { "$ref": "#/$defs/reading" },
    "practice": { "$ref": "#/$defs/practice" },
    "sidePaths": { "type": "array", "items": { "$ref": "#/$defs/sidePath" } }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "plannedMinutes", "instructions", "required"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "plannedMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "instructions": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "rest", "blocks", "definitionOfDone"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "label": { "type": "string" },
        "rest": { "type": "boolean" },
        "phase": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "definitionOfDone": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "days"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "minimum": 1 },
        "consolidation": { "type": "boolean" },
        "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/day" } }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "family"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "coreIntegration", "startDay", "endDay", "defenceAssessmentType", "milestones"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "coreIntegration": { "type": "string", "minLength": 1 },
        "startDay": { "type": "integer", "minimum": 1 },
        "endDay": { "type": "integer", "minimum": 1 },
        "defenceAssessmentType": { "type": "string", "minLength": 1 },
        "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/milestone" } }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["months", "books"],
      "properties": {
        "months": { "type": "array" },
        "books": { "type": "array" }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "stages"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "stages": { "type": "array", "minItems": 1 },
        "categories": { "type": "array", "items": { "type": "string" } },
        "challenges": { "type": "array" }
      }
    },
    "sidePathItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "description"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "creator": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "sidePathStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sidePathItem" } }
      }
    },
    "sidePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "description", "stages"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sidePathStage" } }
      }
    }
  }
}
